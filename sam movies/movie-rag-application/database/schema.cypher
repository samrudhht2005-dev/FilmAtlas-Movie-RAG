
UNWIND [
  "The Prestige|2006|Christopher Nolan|Hugh Jackman|Christian Bale",
  "Dunkirk|2017|Christopher Nolan|Fionn Whitehead|Tom Hardy",
  "Tenet|2020|Christopher Nolan|John David Washington|Robert Pattinson",
  "Oppenheimer|2023|Christopher Nolan|Cillian Murphy|Emily Blunt",
  "Memento|2000|Christopher Nolan|Guy Pearce|Carrie-Anne Moss",
  "The Wolf of Wall Street|2013|Martin Scorsese|Leonardo DiCaprio|Jonah Hill",
  "Goodfellas|1990|Martin Scorsese|Ray Liotta|Robert De Niro",
  "The Departed|2006|Martin Scorsese|Leonardo DiCaprio|Matt Damon",
  "The Irishman|2019|Martin Scorsese|Robert De Niro|Al Pacino",
  "Schindler's List|1993|Steven Spielberg|Liam Neeson|Ben Kingsley",
  "Saving Private Ryan|1998|Steven Spielberg|Tom Hanks|Matt Damon",
  "Catch Me If You Can|2002|Steven Spielberg|Leonardo DiCaprio|Tom Hanks",
  "Minority Report|2002|Steven Spielberg|Tom Cruise|Colin Farrell",
  "E.T. the Extra-Terrestrial|1982|Steven Spielberg|Henry Thomas|Drew Barrymore",
  "Blade Runner|1982|Ridley Scott|Harrison Ford|Rutger Hauer",
  "Blade Runner 2049|2017|Denis Villeneuve|Ryan Gosling|Harrison Ford",
  "Arrival|2016|Denis Villeneuve|Amy Adams|Jeremy Renner",
  "Dune|2021|Denis Villeneuve|Timothee Chalamet|Rebecca Ferguson",
  "Dune: Part Two|2024|Denis Villeneuve|Timothee Chalamet|Zendaya",
  "Mad Max: Fury Road|2015|George Miller|Tom Hardy|Charlize Theron",
  "The Lord of the Rings: The Fellowship of the Ring|2001|Peter Jackson|Elijah Wood|Ian McKellen",
  "The Lord of the Rings: The Two Towers|2002|Peter Jackson|Elijah Wood|Viggo Mortensen",
  "The Lord of the Rings: The Return of the King|2003|Peter Jackson|Elijah Wood|Sean Astin",
  "The Hobbit: An Unexpected Journey|2012|Peter Jackson|Martin Freeman|Ian McKellen",
  "Terminator 2: Judgment Day|1991|James Cameron|Arnold Schwarzenegger|Edward Furlong",
  "Aliens|1986|James Cameron|Sigourney Weaver|Michael Biehn",
  "Avengers: Endgame|2019|Anthony Russo|Robert Downey Jr.|Chris Evans",
  "Avengers: Infinity War|2018|Anthony Russo|Robert Downey Jr.|Josh Brolin",
  "Iron Man|2008|Jon Favreau|Robert Downey Jr.|Gwyneth Paltrow",
  "Black Panther|2018|Ryan Coogler|Chadwick Boseman|Michael B. Jordan",
  "Guardians of the Galaxy|2014|James Gunn|Chris Pratt|Zoe Saldana",
  "Spider-Man: No Way Home|2021|Jon Watts|Tom Holland|Zendaya",
  "Logan|2017|James Mangold|Hugh Jackman|Patrick Stewart",
  "Joker|2019|Todd Phillips|Joaquin Phoenix|Robert De Niro",
  "Barbie|2023|Greta Gerwig|Margot Robbie|Ryan Gosling",
  "Little Women|2019|Greta Gerwig|Saoirse Ronan|Florence Pugh",
  "La La Land|2016|Damien Chazelle|Ryan Gosling|Emma Stone",
  "Whiplash|2014|Damien Chazelle|Miles Teller|J.K. Simmons",
  "Get Out|2017|Jordan Peele|Daniel Kaluuya|Allison Williams",
  "Everything Everywhere All at Once|2022|Daniel Kwan|Michelle Yeoh|Ke Huy Quan",
  "Gone Girl|2014|David Fincher|Ben Affleck|Rosamund Pike",
  "Se7en|1995|David Fincher|Brad Pitt|Morgan Freeman",
  "Knives Out|2019|Rian Johnson|Daniel Craig|Ana de Armas",
  "The Hangover|2009|Todd Phillips|Bradley Cooper|Zach Galifianakis",
  "Back to the Future|1985|Robert Zemeckis|Michael J. Fox|Christopher Lloyd",
  "Ghostbusters|1984|Ivan Reitman|Bill Murray|Dan Aykroyd",
  "Home Alone|1990|Chris Columbus|Macaulay Culkin|Joe Pesci",
  "Shrek|2001|Andrew Adamson|Mike Myers|Eddie Murphy",
  "Kung Fu Panda|2008|Mark Osborne|Jack Black|Dustin Hoffman",
  "How to Train Your Dragon|2010|Chris Sanders|Jay Baruchel|Gerard Butler",
  "My Neighbor Totoro|1988|Hayao Miyazaki|Noriko Hidaka|Chika Sakamoto",
  "Princess Mononoke|1997|Hayao Miyazaki|Yoji Matsuda|Yuriko Ishida",
  "Grave of the Fireflies|1988|Isao Takahata|Tsutomu Tatsumi|Ayano Shiraishi",
  "The Imitation Game|2014|Morten Tyldum|Benedict Cumberbatch|Keira Knightley",
  "The Revenant|2015|Alejandro G. Inarritu|Leonardo DiCaprio|Tom Hardy",
  "The Shape of Water|2017|Guillermo del Toro|Sally Hawkins|Michael Shannon",
  "Oldboy|2003|Park Chan-wook|Choi Min-sik|Yoo Ji-tae",
  "The Handmaiden|2016|Park Chan-wook|Kim Min-hee|Kim Tae-ri",
  "Life of Pi|2012|Ang Lee|Suraj Sharma|Irrfan Khan",
  "Slumdog Millionaire|2008|Danny Boyle|Dev Patel|Freida Pinto",
  "Lagaan|2001|Ashutosh Gowariker|Aamir Khan|Gracy Singh",
  "PK|2014|Rajkumar Hirani|Aamir Khan|Anushka Sharma",
  "Zindagi Na Milegi Dobara|2011|Zoya Akhtar|Hrithik Roshan|Farhan Akhtar",
  "Gully Boy|2019|Zoya Akhtar|Ranveer Singh|Alia Bhatt",
  "Queen|2013|Vikas Bahl|Kangana Ranaut|Rajkummar Rao",
  "Kahaani|2012|Sujoy Ghosh|Vidya Balan|Parambrata Chatterjee",
  "Vikram|2022|Lokesh Kanagaraj|Kamal Haasan|Vijay Sethupathi",
  "Soorarai Pottru|2020|Sudha Kongara|Suriya|Aparna Balamurali",
  "K.G.F: Chapter 2|2022|Prashanth Neel|Yash|Sanjay Dutt",
  "Pushpa: The Rise|2021|Sukumar|Allu Arjun|Rashmika Mandanna",
  "The Lunchbox|2013|Ritesh Batra|Irrfan Khan|Nimrat Kaur",
  "Tumbbad|2018|Rahi Anil Barve|Sohum Shah|Jyoti Malshe"
] AS line
WITH split(line, "|") AS f
MERGE (m:Movie {title: f[0]})
SET m.released = toInteger(f[1])
MERGE (d:Person {name: f[2]})
MERGE (d)-[:DIRECTED]->(m)
WITH f, m
UNWIND [f[3], f[4]] AS actorName
MERGE (a:Person {name: actorName})
MERGE (a)-[:ACTED_IN]->(m)
RETURN count(DISTINCT m) AS movies_processed;

